# Public Microsoft Entra identifiers exposed through /api/config.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# Comma-separated app-role values allowed to edit every employee record.
WELLBEING_ADMIN_ROLES=PFIG.Wellbeing.Admin,PFIG.Portal.Admin

# Server-only secrets. Never expose these values in browser JavaScript.
WELLBEING_SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
